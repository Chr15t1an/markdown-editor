// Static site for markdown.chri5tian.com: the landing page and the release zip, served as Workers
// static assets on the personal Cloudflare account. build/site is produced by
// scripts/package-release.sh; deploy with `npx wrangler deploy` from this directory (docs/release.md).
{
  "name": "markdown-editor-site",
  "compatibility_date": "2026-10-06",
  // Serve only on the custom domain: no *.workers.dev URL and no per-version preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../build/site"
  },
  "routes": [
    { "pattern": "markdown.chri5tian.com", "custom_domain": true }
  ]
}
